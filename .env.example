# Public / non-sensitive configuration
MWANGAZA_ENV=local
MWANGAZA_LOG_LEVEL=INFO
MWANGAZA_DATA_DIR=./data
MWANGAZA_CACHE_DIR=./.cache/mwangaza
MWANGAZA_DEMO_FIXTURE_DIR=./demo_data
MWANGAZA_ENABLED_COUNTRIES=KEN,ETH,SOM,SDN,SSD,UGA,DJI,ERI
MWANGAZA_CLIMATOLOGY_START_YEAR=2001
MWANGAZA_CLIMATOLOGY_END_YEAR=2020
MWANGAZA_MAX_REMOTE_PIXELS=100000000
MWANGAZA_GEE_PROJECT=replace-me
MWANGAZA_NDVI_COLLECTION=MODIS/061/MOD13Q1

# Private / secret configuration. Required only in production.
MWANGAZA_GEE_SERVICE_ACCOUNT=replace-me
MWANGAZA_GEE_PRIVATE_KEY_JSON=replace-me
